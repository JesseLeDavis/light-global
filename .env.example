# Stripe API Keys
# Get these from: https://dashboard.stripe.com/apikeys

# FOR TESTING - Use test keys:
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# FOR PRODUCTION - Comment out test keys above and uncomment live keys below:
# STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
# STRIPE_SECRET_KEY=sk_live_your_key_here

# Organization info
STRIPE_STATEMENT_DESCRIPTOR=LIGHT Global
STRIPE_RECEIPT_EMAIL=info@thelightglobal.com

# SMTP Email Configuration
# Get these from your Hostinger email settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=your_email@thelightglobal.com
SMTP_PASSWORD=your_password_here
